# Variáveis de Ambiente para o Bot do Discord

# Discord (OBRIGATÓRIO)
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Supabase (OBRIGATÓRIO)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=sua-service-role-key

# Supabase (opcional - fallback se SUPABASE_URL/SERVICE_KEY não estiver definido)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon

# OpenRouter (IA) - Opcional se não usar AI
OPENROUTER_API_KEY=sua-chave-openrouter

# IDs de Canais (Opcional - valores padrão Included)
CHAT_CHANNEL_ID=
COMMUNITY_HELP_CHANNEL_ID=
MOD_CURATION_CHANNEL_ID=
CODES_CHANNEL_ID=

# IDs de Cargos (Opcional - valores padrão Included)
VERIFIED_ROLE_ID=